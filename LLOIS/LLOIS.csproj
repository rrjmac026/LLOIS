<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
      <OutputType>WinExe</OutputType>
      <TargetFramework>net10.0-windows</TargetFramework>
      <Nullable>enable</Nullable>
      <ImplicitUsings>enable</ImplicitUsings>
      <UseWPF>true</UseWPF>
      <ApplicationIcon>Assets\Icons\app.ico</ApplicationIcon>
      <SelfContained>true</SelfContained>
      <RuntimeIdentifier>win-x64</RuntimeIdentifier>
      <PublishSingleFile>true</PublishSingleFile>
      <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
      <AssemblyName>DLIS</AssemblyName>
      <AssemblyTitle>DLIS</AssemblyTitle>
      <Product>Damulog Legislative Information System</Product>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.104.1" />
    <PackageReference Include="PdfSharp" Version="6.2.0" />
    <Resource Include="Assets\Icons\app.ico" />
    <Resource Include="Assets\Icons\LOGO.png" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Themes\" />
  </ItemGroup>

  <ItemGroup>
    <!-- Temporarily excluded from the build — not yet converted to the async
         API pattern. Remove each line as that view/service gets migrated. -->

    <!-- Ordinances: OrdinancesView + AddEditOrdinanceWindow are converted —
         only AddAmendmentWindow stays excluded, since amendments are out of
         scope for now and it still targets the old sync API/service shape. -->
    <Compile Remove="Views\Ordinances\AddAmendmentWindow.xaml.cs" />
    <Page Remove="Views\Ordinances\AddAmendmentWindow.xaml" />

    <Compile Remove="Views\Settings\**\*.cs" />
    <Page Remove="Views\Settings\**\*.xaml" />

    <!-- Converted Settings files, re-included despite the blanket folder exclusion above.
         UpdateProgressWindow is a general update dialog also used by MainView. -->
    <Compile Include="Views\Settings\SettingsView.xaml.cs" />
    <Page Include="Views\Settings\SettingsView.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
    <Compile Include="Views\Settings\UpdateProgressWindow.xaml.cs" />
    <Page Include="Views\Settings\UpdateProgressWindow.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
  </ItemGroup>

</Project>