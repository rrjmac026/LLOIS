<Window x:Class="LLOIS.Views.AddEditMinutesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Minutes" Height="440" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource BgPrimaryBrush}">

    <Window.Resources>
        <Thickness x:Key="FieldGap">0,14,0,0</Thickness>
        <Thickness x:Key="LabelGap">0,0,0,5</Thickness>

        <Style TargetType="TextBlock" x:Key="Label">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="{StaticResource LabelGap}"/>
        </Style>
        <Style TargetType="Run" x:Key="ReqMark">
            <Setter Property="Foreground" Value="{DynamicResource DangerFgBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderMedBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource BgHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RemoveBtn" TargetType="Button" BasedOn="{StaticResource SecondaryBtn}">
            <Setter Property="Foreground" Value="{DynamicResource DangerFgBrush}"/>
            <Setter Property="Padding" Value="8,5"/>
        </Style>

        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{DynamicResource BrandBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel Margin="0">

        <Border DockPanel.Dock="Top" Background="{DynamicResource BrandBrush}" Padding="22,16">
            <TextBlock x:Name="WindowTitle" Text="Add Minutes"
                       Foreground="White" FontSize="17" FontWeight="Bold"/>
        </Border>

        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource BgSecondaryBrush}"
                BorderBrush="{DynamicResource BorderThinBrush}"
                BorderThickness="0,1,0,0" Padding="22,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelBtn" Content="Cancel" Width="92" Margin="0,0,10,0"
                        Style="{StaticResource SecondaryBtn}" Click="CancelBtn_Click"/>
                <Button x:Name="SaveBtn" Content="💾  Save" Width="120"
                        Style="{StaticResource PrimaryBtn}" Click="SaveBtn_Click"/>
            </StackPanel>
        </Border>

        <StackPanel Margin="22,18,22,18">

            <Border x:Name="ErrorBanner"
                    Background="{DynamicResource DangerBgBrush}"
                    BorderBrush="{DynamicResource DangerBorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="12,10"
                    Margin="0,0,0,16" Visibility="Collapsed">
                <TextBlock x:Name="ErrorText"
                           Foreground="{DynamicResource DangerFgBrush}"
                           TextWrapping="Wrap" FontSize="12.5"/>
            </Border>

            <TextBlock Style="{StaticResource Label}">
                Session Type <Run Text="*" Style="{StaticResource ReqMark}"/>
            </TextBlock>
            <ComboBox x:Name="SessionTypeCombo" Height="34">
                <ComboBoxItem Content="Regular Session"/>
                <ComboBoxItem Content="Special Session"/>
            </ComboBox>

            <TextBlock Text="Date" Style="{StaticResource Label}" Margin="{StaticResource FieldGap}"/>
            <DatePicker x:Name="DatePickerControl" Height="34"/>

            <TextBlock Text="Attachment" Style="{StaticResource Label}" Margin="{StaticResource FieldGap}"/>
            <DockPanel>
                <Button x:Name="RemoveFileBtn" DockPanel.Dock="Right" Content="✕" Width="34" Height="34"
                        Margin="8,0,0,0" Style="{StaticResource RemoveBtn}"
                        Click="RemoveFileBtn_Click"
                        ToolTip="Remove attached file"/>
                <Button DockPanel.Dock="Right" Content="Browse…" Width="100" Height="34"
                        Margin="8,0,0,0" Style="{StaticResource SecondaryBtn}"
                        Click="BrowseFile_Click"/>
                <TextBox x:Name="FilePathBox" IsReadOnly="True" Height="34"
                         Style="{StaticResource PlaceholderTextBox}"
                         Tag="No file attached"/>
            </DockPanel>

        </StackPanel>
    </DockPanel>
</Window>