<UserControl x:Class="LLOIS.Views.CommitteeReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BgPrimaryBrush}">

    <DockPanel>

        <!-- ── Search / filter bar ───────────────────────────── -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource BgSecondaryBrush}"
                BorderBrush="{DynamicResource BorderThinBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,10">
            <DockPanel>
                <!-- Add button (right) -->
                <Button x:Name="AddBtn"
                        DockPanel.Dock="Right"
                        Style="{StaticResource AddBtn}"
                        Content="➕  Add committee report"
                        Click="AddBtn_Click"
                        Visibility="Collapsed"/>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Search -->
                    <Border Background="{DynamicResource BgPrimaryBrush}"
                            BorderBrush="{DynamicResource BorderThinBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Width="280" Height="34"
                            Margin="0,0,10,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left"
                                       Text="🔍" FontSize="13"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       VerticalAlignment="Center"
                                       Margin="10,0,6,0"/>
                            <TextBox x:Name="SearchBox"
                                     Style="{StaticResource PlaceholderTextBox}"
                                     Tag="Search by number, subject, submitted by…"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     VerticalAlignment="Center"
                                     TextChanged="SearchBox_TextChanged"
                                     KeyDown="SearchBox_KeyDown"/>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ── Main split ────────────────────────────────────── -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" MinWidth="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── LIST PANEL ──────────────────────────────────── -->
            <Border Grid.Column="0"
                    Background="{DynamicResource BgSecondaryBrush}"
                    BorderBrush="{DynamicResource BorderThinBrush}"
                    BorderThickness="0,0,1,0">
                <DockPanel>
                    <!-- Count header -->
                    <Border DockPanel.Dock="Top"
                            Padding="14,8"
                            BorderBrush="{DynamicResource BorderThinBrush}"
                            BorderThickness="0,0,0,1">
                        <TextBlock x:Name="ResultCount"
                                Text="Loading…"
                                FontSize="12" FontWeight="SemiBold"
                                Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Border>

                    <ListBox x:Name="ReportList"
                            SelectionChanged="ReportList_SelectionChanged"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            VirtualizingPanel.IsVirtualizing="True">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="14,10,14,10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="4"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="6"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0"
                                            Text="{Binding ReportNumber}"
                                            FontSize="11" FontWeight="SemiBold"
                                            Foreground="{DynamicResource BrandBrush}"/>

                                    <TextBlock Grid.Row="2"
                                            Text="{Binding Subject}"
                                            FontSize="12"
                                            Foreground="{DynamicResource TextPrimaryBrush}"
                                            TextWrapping="NoWrap"
                                            TextTrimming="CharacterEllipsis"/>

                                    <TextBlock Grid.Row="4"
                                            Text="{Binding SubmittedBy, StringFormat='Submitted by {0}'}"
                                            FontSize="10"
                                            Foreground="{DynamicResource TextTertiaryBrush}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- ── DETAIL PANE ──────────────────────────────────── -->
            <DockPanel Grid.Column="1"
                       Background="{DynamicResource BgPrimaryBrush}">

                <!-- Action bar -->
                <Border DockPanel.Dock="Top"
                        x:Name="ActionBar"
                        Background="{DynamicResource BgSecondaryBrush}"
                        BorderBrush="{DynamicResource BorderThinBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="16,8"
                        Visibility="Collapsed">
                    <DockPanel>
                        <Button x:Name="DeleteBtn"
                                DockPanel.Dock="Right"
                                Content="🗑 Delete"
                                Style="{StaticResource ActionDangerBtn}"
                                Click="DeleteBtn_Click"
                                Visibility="Collapsed"/>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="EditBtn"
                                    Content="✏ Edit"
                                    Style="{StaticResource ActionBtn}"
                                    Margin="0,0,6,0"
                                    Click="EditBtn_Click"
                                    Visibility="Collapsed"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Detail scroll area -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="DetailPanel"
                                Visibility="Collapsed"
                                Margin="20,16,20,24">

                        <!-- Hero card -->
                        <Border x:Name="HeroCard"
                                CornerRadius="10"
                                Padding="20,16"
                                Margin="0,0,0,16">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="{DynamicResource HeroBgStartColor}" Offset="0"/>
                                    <GradientStop Color="{DynamicResource HeroBgEndColor}"   Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel>
                                <TextBlock x:Name="DetailNumber"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource HeroNumFgBrush}"/>
                                <TextBlock x:Name="DetailSubject"
                                           FontSize="16" FontWeight="SemiBold"
                                           Foreground="{DynamicResource HeroTitleFgBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,0"/>
                                <TextBlock x:Name="DetailDate"
                                           FontSize="12"
                                           Foreground="{DynamicResource HeroSubjectFgBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,10"/>
                                <WrapPanel>
                                    <Border x:Name="AttachmentBadge"
                                            Background="#18FFFFFF" BorderBrush="#22FFFFFF"
                                            BorderThickness="1"
                                            CornerRadius="10" Padding="9,3" Margin="0,0,6,4"
                                            Visibility="Collapsed">
                                        <TextBlock x:Name="AttachmentBadgeText"
                                                   Text="📎 Files attached"
                                                   FontSize="11" Foreground="#B8CEF0"/>
                                    </Border>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- Action buttons row (edit) -->
                        <StackPanel x:Name="InlineActionRow"
                                    Orientation="Horizontal"
                                    Margin="0,0,0,16"
                                    Visibility="Collapsed">
                            <Button x:Name="InlineEditBtn"
                                    Content="✏ Edit"
                                    Style="{StaticResource ActionBtn}"
                                    Click="EditBtn_Click"
                                    Visibility="Collapsed"/>
                        </StackPanel>

                        <!-- Metadata -->
                        <TextBlock Text="DETAILS"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   Margin="0,0,0,8"/>
                        <UniformGrid x:Name="MetadataGrid" Columns="2" Margin="0,0,0,16"/>

                        <!-- Attachments -->
                        <TextBlock Text="ATTACHMENTS"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   Margin="0,0,0,8"/>
                        <ItemsControl x:Name="AttachmentsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource BorderThinBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="12,10"
                                            Margin="0,0,0,8">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right"
                                                    Content="Open"
                                                    Style="{StaticResource ActionBtn}"
                                                    Click="OpenAttachment_Click"
                                                    Tag="{Binding FilePath}"/>
                                            <TextBlock Text="{Binding FileName}"
                                                       VerticalAlignment="Center"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>