<UserControl x:Class="LLOIS.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BgPrimaryBrush}">

    <UserControl.Resources>
        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background"      Value="{DynamicResource StatCardBgBrush}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource StatCardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="10"/>
            <Setter Property="Padding"         Value="18,16"/>
        </Style>

        <!-- Clickable module card with hover lift -->
        <Style x:Key="ModuleCard" TargetType="Border">
            <Setter Property="CornerRadius"    Value="12"/>
            <Setter Property="Padding"         Value="20,18"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource StatCardBorderBrush}"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Background"      Value="{DynamicResource StatCardBgBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BgHoverBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource BrandBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ModuleIconBadge" TargetType="Border">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24,28,28">

            <!-- ── Greeting ──────────────────────────────────────── -->
             <Border Style="{StaticResource StatCard}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock x:Name="GreetingLabel"
                            Text="Good morning, admin"
                            FontSize="20" FontWeight="Bold"
                            Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="Here's what's happening in the system today."
                            FontSize="13"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <TextBlock Text="OVERVIEW"
           FontSize="11" FontWeight="SemiBold"
           Foreground="{DynamicResource TextTertiaryBrush}"
           Margin="0,0,0,10"/>

            <UniformGrid Rows="1" Columns="3" Margin="0,0,0,20">

                <!-- Ordinances -->
                <Border Style="{StaticResource ModuleCard}" Margin="0,0,7,0"
                        MouseLeftButtonUp="OrdinancesCard_Click">
                    <StackPanel>
                        <DockPanel>
                            <Border Style="{StaticResource ModuleIconBadge}"
                                    Background="#1A6C63FF">
                                <TextBlock Text="📜" FontSize="17"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock DockPanel.Dock="Right"
                                    Text="→" FontSize="16"
                                    Foreground="{DynamicResource TextTertiaryBrush}"
                                    VerticalAlignment="Top" HorizontalAlignment="Right"/>
                        </DockPanel>
                        <TextBlock x:Name="OrdinanceCount"
                                Text="—" FontSize="32" FontWeight="Bold"
                                Foreground="{DynamicResource TextPrimaryBrush}"
                                Margin="0,12,0,0"/>
                        <TextBlock Text="Ordinances"
                                FontSize="12" FontWeight="SemiBold"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                Margin="0,2,0,0"/>
                        <TextBlock x:Name="OrdinanceSub"
                                Text="—"
                                FontSize="11"
                                Foreground="{DynamicResource TextTertiaryBrush}"
                                Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Resolutions -->
                <Border Style="{StaticResource ModuleCard}" Margin="7,0,7,0"
                        MouseLeftButtonUp="ResolutionsCard_Click">
                    <StackPanel>
                        <DockPanel>
                            <Border Style="{StaticResource ModuleIconBadge}"
                                    Background="#1A2E9E5A">
                                <TextBlock Text="🗳" FontSize="17"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock DockPanel.Dock="Right"
                                    Text="→" FontSize="16"
                                    Foreground="{DynamicResource TextTertiaryBrush}"
                                    VerticalAlignment="Top" HorizontalAlignment="Right"/>
                        </DockPanel>
                        <TextBlock x:Name="ResolutionCount"
                                Text="—" FontSize="32" FontWeight="Bold"
                                Foreground="{DynamicResource TextPrimaryBrush}"
                                Margin="0,12,0,0"/>
                        <TextBlock Text="Resolutions"
                                FontSize="12" FontWeight="SemiBold"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                Margin="0,2,0,0"/>
                        <TextBlock x:Name="ResolutionSub"
                                Text="—"
                                FontSize="11"
                                Foreground="{DynamicResource TextTertiaryBrush}"
                                Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Committee Reports -->
                <Border Style="{StaticResource ModuleCard}" Margin="7,0,0,0"
                        MouseLeftButtonUp="CommitteeReportsCard_Click">
                    <StackPanel>
                        <DockPanel>
                            <Border Style="{StaticResource ModuleIconBadge}"
                                    Background="#1AE0A030">
                                <TextBlock Text="🗂" FontSize="17"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock DockPanel.Dock="Right"
                                    Text="→" FontSize="16"
                                    Foreground="{DynamicResource TextTertiaryBrush}"
                                    VerticalAlignment="Top" HorizontalAlignment="Right"/>
                        </DockPanel>
                        <TextBlock x:Name="ReportCount"
                                Text="—" FontSize="32" FontWeight="Bold"
                                Foreground="{DynamicResource TextPrimaryBrush}"
                                Margin="0,12,0,0"/>
                        <TextBlock Text="Committee Reports"
                                FontSize="12" FontWeight="SemiBold"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                Margin="0,2,0,0"/>
                        <TextBlock x:Name="ReportSub"
                                Text="—"
                                FontSize="11"
                                Foreground="{DynamicResource TextTertiaryBrush}"
                                Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

            </UniformGrid>

            <!-- ── Bottom row: By status + Recent actions ────────── -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- By status card -->
                <Border Grid.Column="0" Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="By status"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="0,0,0,14"/>

                        <!-- In Effect row -->
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock DockPanel.Dock="Left" Text="In effect"
                                       FontSize="12" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Width="90"/>
                            <TextBlock x:Name="StatusInEffectNum"
                                       DockPanel.Dock="Right" Text="—"
                                       FontSize="12" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Width="30"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       HorizontalAlignment="Right"/>
                            <Border x:Name="StatusInEffectPill"
                                    DockPanel.Dock="Right"
                                    Background="{DynamicResource StatusInEffectBgBrush}"
                                    CornerRadius="8" Padding="7,2" Margin="0,0,6,0"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="StatusInEffectPct"
                                           Text="—"
                                           FontSize="10" FontWeight="Bold"
                                           Foreground="{DynamicResource StatusInEffectFgBrush}"/>
                            </Border>
                        </DockPanel>

                        <!-- Amended row -->
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock DockPanel.Dock="Left" Text="Amended"
                                       FontSize="12" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Width="90"/>
                            <TextBlock x:Name="StatusAmendedNum"
                                       DockPanel.Dock="Right" Text="—"
                                       FontSize="12" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Width="30"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       HorizontalAlignment="Right"/>
                            <Border Background="{DynamicResource StatusAmendedBgBrush}"
                                    DockPanel.Dock="Right"
                                    CornerRadius="8" Padding="7,2" Margin="0,0,6,0"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="StatusAmendedPct"
                                           Text="—"
                                           FontSize="10" FontWeight="Bold"
                                           Foreground="{DynamicResource StatusAmendedFgBrush}"/>
                            </Border>
                        </DockPanel>

                        <!-- Repealed row -->
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock DockPanel.Dock="Left" Text="Repealed"
                                       FontSize="12" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Width="90"/>
                            <TextBlock x:Name="StatusRepealedNum"
                                       DockPanel.Dock="Right" Text="—"
                                       FontSize="12" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Width="30"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       HorizontalAlignment="Right"/>
                            <Border Background="{DynamicResource StatusRepealedBgBrush}"
                                    DockPanel.Dock="Right"
                                    CornerRadius="8" Padding="7,2" Margin="0,0,6,0"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="StatusRepealedPct"
                                           Text="—"
                                           FontSize="10" FontWeight="Bold"
                                           Foreground="{DynamicResource StatusRepealedFgBrush}"/>
                            </Border>
                        </DockPanel>

                        <!-- Under Review row -->
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="Under review"
                                       FontSize="12" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Width="90"/>
                            <TextBlock x:Name="StatusReviewNum"
                                       DockPanel.Dock="Right" Text="—"
                                       FontSize="12" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Width="30"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       HorizontalAlignment="Right"/>
                            <Border Background="{DynamicResource StatusReviewBgBrush}"
                                    DockPanel.Dock="Right"
                                    CornerRadius="8" Padding="7,2" Margin="0,0,6,0"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="StatusReviewPct"
                                           Text="—"
                                           FontSize="10" FontWeight="Bold"
                                           Foreground="{DynamicResource StatusReviewFgBrush}"/>
                            </Border>
                        </DockPanel>

                    </StackPanel>
                </Border>

                <!-- Recent actions card -->
                <Border Grid.Column="2" Style="{StaticResource StatCard}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top"
                                   Text="Recent actions"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="0,0,0,14"/>
                        <ItemsControl x:Name="RecentActionsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,0,0,10" LastChildFill="False">
                                        <TextBlock DockPanel.Dock="Right"
                                                   Text="{Binding TimeAgo}"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Description}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>

            </Grid>

            <!-- ── Info tip ────────────────────────────────────── -->
            <Border Margin="0,16,0,0"
                    Background="{DynamicResource BgSecondaryBrush}"
                    BorderBrush="{DynamicResource BorderThinBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14,10">
                <TextBlock x:Name="RoleTipLabel"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           FontSize="11"
                           TextWrapping="Wrap"/>
            </Border>

        </StackPanel>
    </ScrollViewer>

</UserControl>
