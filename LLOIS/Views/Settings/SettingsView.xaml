<UserControl x:Class="LLOIS.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BgPrimaryBrush}">

    <UserControl.Resources>
        <Style x:Key="SettingsRowBtn" TargetType="Button">
            <Setter Property="Height" Value="52"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{DynamicResource BgSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderThinBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgHoverBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrandBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel Margin="24" MaxWidth="500" HorizontalAlignment="Left">

        <TextBlock x:Name="VersionLabel"
                   FontSize="12"
                   Foreground="{DynamicResource TextTertiaryBrush}"
                   Margin="0,0,0,20"/>

        <TextBlock Text="APPLICATION"
                   FontSize="11" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextTertiaryBrush}"
                   Margin="0,0,0,8"/>

        <Grid Margin="0,0,0,10">
            <Button x:Name="CheckUpdateBtn"
                    Style="{StaticResource SettingsRowBtn}"
                    Click="CheckUpdateBtn_Click">
                <DockPanel Margin="14,0">
                    <TextBlock DockPanel.Dock="Left" Text="🔄" FontSize="16"
                            VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Check for Updates" FontSize="13" FontWeight="SemiBold"
                                Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock x:Name="UpdateStatusText"
                                Text="Click to check for the latest version"
                                FontSize="11"
                                Foreground="{DynamicResource TextTertiaryBrush}"/>
                    </StackPanel>
                </DockPanel>
            </Button>

            <!-- Corner notification dot -->
            <Border x:Name="UpdateAvailableBadge"
                    Width="12" Height="12"
                    CornerRadius="6"
                    Background="#DC2626"
                    BorderBrush="{DynamicResource BgPrimaryBrush}"
                    BorderThickness="2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,-4,-4,0"
                    Visibility="Collapsed"
                    IsHitTestVisible="False"/>
        </Grid>

        <TextBlock Text="DATA"
                   FontSize="11" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextTertiaryBrush}"
                   Margin="0,16,0,8"/>

        <Button x:Name="BackupBtn"
                Style="{StaticResource SettingsRowBtn}"
                Click="BackupBtn_Click">
            <DockPanel Margin="14,0">
                <TextBlock DockPanel.Dock="Left" Text="💾" FontSize="16"
                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Backup Data" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="BackupStatusText"
                               Text="Export all data and files to a ZIP archive"
                               FontSize="11"
                               Foreground="{DynamicResource TextTertiaryBrush}"/>
                </StackPanel>
            </DockPanel>
        </Button>

    </StackPanel>
</UserControl>