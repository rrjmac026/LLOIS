<Window x:Class="LLOIS.Views.AddEditResolutionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Resolution" Height="660" Width="720"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource BgPrimaryBrush}">

    <Window.Resources>
        <Thickness x:Key="SectionGap">0,22,0,0</Thickness>
        <Thickness x:Key="FieldGap">0,14,0,0</Thickness>
        <Thickness x:Key="LabelGap">0,0,0,5</Thickness>

        <Style TargetType="TextBlock" x:Key="Label">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="{StaticResource LabelGap}"/>
        </Style>
        <Style TargetType="Run" x:Key="ReqMark">
            <Setter Property="Foreground" Value="{DynamicResource DangerFgBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="SectionTitle">
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style TargetType="Border" x:Key="SectionCard">
            <Setter Property="Background" Value="{DynamicResource BgSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderThinBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18,16"/>
        </Style>

        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderMedBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource BgHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RemoveBtn" TargetType="Button" BasedOn="{StaticResource SecondaryBtn}">
            <Setter Property="Foreground" Value="{DynamicResource DangerFgBrush}"/>
            <Setter Property="Padding" Value="8,5"/>
        </Style>

        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{DynamicResource BrandBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel Margin="0">

        <Border DockPanel.Dock="Top" Background="{DynamicResource BrandBrush}" Padding="22,16">
            <StackPanel>
                <TextBlock x:Name="WindowTitle" Text="Add New Resolution"
                           Foreground="White" FontSize="17" FontWeight="Bold"/>
                <TextBlock Text="Fill in the details below. Fields marked with * are required."
                           Foreground="#C8DCFF" FontSize="11.5" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource BgSecondaryBrush}"
                BorderBrush="{DynamicResource BorderThinBrush}"
                BorderThickness="0,1,0,0" Padding="22,14">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="* Required fields" FontSize="11"
                           Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelBtn" Content="Cancel" Width="92" Margin="0,0,10,0"
                            Style="{StaticResource SecondaryBtn}" Click="CancelBtn_Click"/>
                    <Button x:Name="SaveBtn" Content="💾  Save Resolution" Width="170"
                            Style="{StaticResource PrimaryBtn}" Click="SaveBtn_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="22,18,22,18">

                <Border x:Name="ErrorBanner"
                        Background="{DynamicResource DangerBgBrush}"
                        BorderBrush="{DynamicResource DangerBorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="12,10"
                        Margin="0,0,0,16" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚠" Foreground="{DynamicResource DangerFgBrush}"
                                   FontSize="14" Margin="0,0,8,0" VerticalAlignment="Top"/>
                        <TextBlock x:Name="ErrorText"
                                   Foreground="{DynamicResource DangerFgBrush}"
                                   TextWrapping="Wrap" FontSize="12.5"/>
                    </StackPanel>
                </Border>

                <!-- ── Identity ─────────────────────────────── -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="Resolution Identity" Style="{StaticResource SectionTitle}" Margin="0,0,0,14"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource Label}">
                                    Resolution Number <Run Text="*" Style="{StaticResource ReqMark}"/>
                                </TextBlock>
                                <TextBox x:Name="ResNumberBox" Height="34"
                                         Style="{StaticResource PlaceholderTextBox}"
                                         Tag="e.g. 157-2026"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="SB Term" Style="{StaticResource Label}"/>
                                <TextBox x:Name="SbTermBox" Height="34"
                                         Style="{StaticResource PlaceholderTextBox}"
                                         Tag="e.g. 16th SB"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="{StaticResource FieldGap}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Session Info" Style="{StaticResource Label}"/>
                                <TextBox x:Name="SessionInfoBox" Height="34"
                                         Style="{StaticResource PlaceholderTextBox}"
                                         Tag="e.g. 30th Regular Session"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Committee" Style="{StaticResource Label}"/>
                                <TextBox x:Name="CommitteeBox" Height="34"
                                         Style="{StaticResource PlaceholderTextBox}"
                                         Tag="e.g. Committee on Finance"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Margin="{StaticResource FieldGap}">
                            <TextBlock Style="{StaticResource Label}">
                                Title <Run Text="*" Style="{StaticResource ReqMark}"/>
                            </TextBlock>
                            <TextBox x:Name="TitleBox" Height="64"
                                     Style="{StaticResource PlaceholderTextBox}"
                                     Tag="Full resolution title"
                                     TextWrapping="Wrap" AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto" Padding="8,8"/>
                        </StackPanel>

                        <Grid Margin="{StaticResource FieldGap}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource Label}">
                                    Sponsor <Run Text="*" Style="{StaticResource ReqMark}"/>
                                </TextBlock>
                                <TextBox x:Name="SponsorBox" Height="34"
                                         Style="{StaticResource PlaceholderTextBox}"
                                         Tag="e.g. Hon. Rennie S. Bon"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Date Approved" Style="{StaticResource Label}"/>
                                <DatePicker x:Name="DateApprovedPicker" Height="34"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ── File Attachment ─────────────────────────────── -->
                <Border Style="{StaticResource SectionCard}" Margin="{StaticResource SectionGap}">
                    <StackPanel>
                        <TextBlock Text="Document Attachment" Style="{StaticResource SectionTitle}" Margin="0,0,0,14"/>
                        <DockPanel>
                            <Button x:Name="RemoveFileBtn" DockPanel.Dock="Right" Content="✕" Width="34" Height="34"
                                    Margin="8,0,0,0" Style="{StaticResource RemoveBtn}"
                                    Click="RemoveFileBtn_Click"
                                    ToolTip="Remove attached file"/>
                            <Button DockPanel.Dock="Right" Content="Browse…" Width="100" Height="34"
                                    Margin="8,0,0,0" Style="{StaticResource SecondaryBtn}"
                                    Click="BrowseFile_Click"/>
                            <TextBox x:Name="FilePathBox" IsReadOnly="True" Height="34"
                                    Style="{StaticResource PlaceholderTextBox}"
                                    Tag="No file attached"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>