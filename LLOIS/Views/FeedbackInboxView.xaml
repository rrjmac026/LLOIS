<UserControl x:Class="LLOIS.Views.FeedbackInboxView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BgPrimaryBrush}">

    <DockPanel>

        <!-- ── Count header ───────────────────────────────── -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource BgSecondaryBrush}"
                BorderBrush="{DynamicResource BorderThinBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,10">
            <TextBlock x:Name="ResultCount" Text="Loading…"
                       FontSize="12" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
        </Border>

        <!-- ── Main split ─────────────────────────────────── -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── LIST PANEL ────────────────────────────── -->
            <Border Grid.Column="0"
                    Background="{DynamicResource BgSecondaryBrush}"
                    BorderBrush="{DynamicResource BorderThinBrush}"
                    BorderThickness="0,0,1,0">
                <ListBox x:Name="FeedbackList"
                         SelectionChanged="FeedbackList_SelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="14,10,14,10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="4"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="6"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Orientation="Horizontal">
                                    <TextBlock Text="{Binding Type}"
                                               FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource BrandBrush}"/>
                                    <Border CornerRadius="8" Padding="6,2" Margin="8,0,0,0"
                                            Background="{DynamicResource BgTertiaryBrush}">
                                        <TextBlock Text="{Binding Status}"
                                                   FontSize="9" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </Border>
                                </StackPanel>

                                <TextBlock Grid.Row="2"
                                           Text="{Binding Message}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis"/>

                                <TextBlock Grid.Row="4"
                                           Text="{Binding SubmittedBy}"
                                           FontSize="10"
                                           Foreground="{DynamicResource TextTertiaryBrush}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- ── DETAIL PANE ───────────────────────────── -->
            <DockPanel Grid.Column="1" Background="{DynamicResource BgPrimaryBrush}">

                <Border DockPanel.Dock="Top"
                        x:Name="ActionBar"
                        Background="{DynamicResource BgSecondaryBrush}"
                        BorderBrush="{DynamicResource BorderThinBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="16,8"
                        Visibility="Collapsed">
                    <Button x:Name="ResolveBtn" Content="✔ Mark Resolved"
                            Style="{StaticResource ActionBtn}"
                            HorizontalAlignment="Left"
                            Click="ResolveBtn_Click"/>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="DetailPanel"
                                Visibility="Collapsed"
                                Margin="20,16,20,24">

                        <!-- Hero card -->
                        <Border CornerRadius="10"
                                Padding="20,16"
                                Margin="0,0,0,16">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="{DynamicResource HeroBgStartColor}" Offset="0"/>
                                    <GradientStop Color="{DynamicResource HeroBgEndColor}"   Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel>
                                <TextBlock x:Name="DetailType"
                                           FontSize="16" FontWeight="SemiBold"
                                           Foreground="{DynamicResource HeroTitleFgBrush}"/>
                                <TextBlock x:Name="DetailMeta"
                                           FontSize="12"
                                           Foreground="{DynamicResource HeroSubjectFgBrush}"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Message -->
                        <TextBlock Text="MESSAGE"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   Margin="0,0,0,8"/>
                        <Border BorderBrush="{DynamicResource BorderThinBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14,12">
                            <TextBlock x:Name="DetailMessage" FontSize="13"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>